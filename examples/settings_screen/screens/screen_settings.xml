<screen>
    <view flex_flow="column"
          style_flex_main_place="center"
          style_flex_cross_place="center"
          style_pad_row="16"
          style_bg_color="0xffffff"
          style_text_color="0x111827">
        <bind_style name="style_dark" subject="subject_dark_mode" ref_value="1" />
        <lv_label name="title" text="Settings" />
        <lv_obj name="dark_mode_row"
                flex_flow="row"
                style_flex_cross_place="center"
                style_pad_column="12"
                style_bg_opa="0"
                style_border_width="0"
                width="content"
                height="content">
            <lv_label name="dark_mode_label" text="Dark Mode" />
            <lv_switch name="dark_mode_switch" bind_checked="subject_dark_mode">
                <subject_toggle_event subject="subject_dark_mode" trigger="clicked" />
            </lv_switch>
        </lv_obj>
        <lv_button name="btn_back">
            <lv_label name="btn_back_label" text="Back" align="center" />
            <screen_load_event screen="screen_home" trigger="clicked" />
        </lv_button>
    </view>
</screen>
