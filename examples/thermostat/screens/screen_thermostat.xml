<screen>
    <view flex_flow="column"
          style_flex_main_place="center"
          style_flex_cross_place="center"
          style_pad_row="12">
        <lv_label name="title" text="Temperature" />
        
        <lv_arc name="temp_arc"
                width="180"
                height="180"
                min_value="15"
                max_value="30"
                bind_value="subject_temp">
            <lv_label name="temp_label"
                      align="center"
                      bind_text="subject_temp"
                      bind_text-fmt="%d°C" />
        </lv_arc>
        
        <lv_obj name="controls_row"
                flex_flow="row"
                style_flex_cross_place="center"
                style_pad_column="16"
                style_bg_opa="0"
                style_border_width="0"
                width="content"
                height="content">
            <lv_button name="btn_minus">
                <lv_label name="btn_minus_label" text="-" align="center" />
                <subject_increment_event subject="subject_temp" step="-1" min_value="15" max_value="30" trigger="clicked" />
            </lv_button>
            <lv_button name="btn_plus">
                <lv_label name="btn_plus_label" text="+" align="center" />
                <subject_increment_event subject="subject_temp" step="1" min_value="15" max_value="30" trigger="clicked" />
            </lv_button>
        </lv_obj>

        <lv_dropdown name="mode_dropdown"
                     options="Heat&#10;Cool&#10;Auto&#10;Off"
                     bind_value="subject_mode" />
    </view>
</screen>
